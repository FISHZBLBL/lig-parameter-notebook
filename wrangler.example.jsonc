{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lig-parameter-notebook",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lig-lab-notebook",
      "migrations_dir": "migrations",
      "database_id": "YOUR_PRIMARY_DATABASE_ID"
    },
    {
      "binding": "BACKUP_DB",
      "database_name": "lig-lab-backups",
      "migrations_dir": "backup-migrations",
      "database_id": "YOUR_BACKUP_DATABASE_ID"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "you@example.com",
    "AUTH_MODE": "code"
  },
  "triggers": {
    "crons": [
      "0 14 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
